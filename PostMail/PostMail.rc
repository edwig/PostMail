IDR_MENU1 MENU
BEGIN
    POPUP "MENU"
    BEGIN
        MENUITEM "Lime",                        ID_THEMA_LIME
        MENUITEM "Skyblue",                     ID_THEMA_SKYBLUE
        MENUITEM "Purple",                      ID_THEMA_PURPLE
        MENUITEM "Mustard",                     ID_THEMA_MUSTARD
        MENUITEM "Moderate gray",               ID_THEMA_MODERATE
        MENUITEM "Pure gray",                   ID_THEMA_PUREGRAY
        MENUITEM "Black && White",              ID_THEMA_BLACKWHITE
        MENUITEM "Dark Theme",                  ID_THEMA_DARKTHEME
        MENUITEM SEPARATOR
        MENUITEM "Encrypt text...",             32784
        MENUITEM "Manual...",                   ID_HELP_MANUAL
        MENUITEM "Command line...",             ID_HELP_COMMANDLINE
        MENUITEM "About PostMail...",           ID_HELP_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "Exit PostMail",               ID_CLOSE
    END
END

IDR_MENU2 MENU
BEGIN
    POPUP "MENU"
    BEGIN
        POPUP "Thema"
        BEGIN
            MENUITEM "Lime",                        ID_THEMA_LIME
            MENUITEM "Skyblue",                     ID_THEMA_SKYBLUE
            MENUITEM "Purple",                      ID_THEMA_PURPLE
            MENUITEM "Mustard",                     ID_THEMA_MUSTARD
            MENUITEM "Moderate gray",               ID_THEMA_MODERATE
            MENUITEM "Pure gray",                   ID_THEMA_PUREGRAY
            MENUITEM "Black && White",              ID_THEMA_BLACKWHITE
            MENUITEM "Dark",                        ID_THEMA_DARKTHEME
        END
        MENUITEM "About PostMailEncrypt",         ID_HELP_ABOUT
    END
END



