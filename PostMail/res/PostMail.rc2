//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PRODUCT_VERSION_BIN
 PRODUCTVERSION PRODUCT_VERSION_BIN
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "FileDescription", "Post mail by MS-Graph or by SMTP (Simple Mail Transport Protocol)"
            VALUE "FileVersion",      PRODUCT_VERSION
            VALUE "InternalName",     WHOAMI
            VALUE "LegalCopyright",   "Written by W.E. Huisman (2006-2026)"
            VALUE "OriginalFilename", "PostMail.exe"
            VALUE "ProductName",      PRODUCT_NAME
            VALUE "ProductVersion",   PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
