    EDITTEXT        IDC_VERSIE,50,7,167,14,ES_AUTOHSCROLL | ES_READONLY
    EDITTEXT        IDC_COPYRIGHT,50,23,167,14,ES_AUTOHSCROLL | ES_READONLY
    DEFPUSHBUTTON   "OK",IDOK,147,42,70,14,WS_GROUP
END

IDD_POSTMAILENCRYPT DIALOGEX 0, 0, 358, 105
STYLE DS_SETFONT | WS_POPUP | WS_SYSMENU
FONT 10, "Verdana", 400, 0, 0x0
BEGIN
    LTEXT           "Text to encrypt",IDC_STATIC,7,9,58,8
    EDITTEXT        IDC_EDIT1,69,7,281,14,ES_AUTOHSCROLL
    LTEXT           "Repeat the text",IDC_STATIC,7,27,57,8
    EDITTEXT        IDC_EDIT2,69,24,281,14,ES_AUTOHSCROLL
    LTEXT           "Encrypted",IDC_STATIC,7,58,48,8
    EDITTEXT        IDC_EDIT3,69,55,281,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Copy",IDC_COPY,230,72,57,14
    DEFPUSHBUTTON   "OK",IDOK,293,72,57,14
    CONTROL         "Show the texts",IDC_TOON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,69,42,92,10
END


